{
  "style": {
    "border": {
      "type": "thicc",
      "color": "#888888",
      "focusedColor": "#444444"
    }
  },
  "layout": {
    "type": "container",
    "direction": "row",
    "children": [
      {
        "type": "container",
        "direction": "column",
        "flex": 1,
        "children": [
          {
            "type": "component",
            "flex": 3,
            "component": {
              "id": "long-text",
              "type": "text",
              "title": "📙 Scrollable Text",
              "data": {
                "source": "script",
                "command": "cat ./dashboard.json"
              },
              "bindings": [
                {
                  "key": "f",
                  "label": "Show full README",
                  "action": {
                    "type": "replace_pane",
                    "command": "cat ./README.md",
                    "output_as": "text"
                  }
                },
                {
                  "key": "o",
                  "label": "Open dashboard.json in editor",
                  "action": {
                    "type": "fire_and_forget",
                    "command": "open ./dashboard.json"
                  }
                }
              ]
            }
          },
          {
            "type": "component",
            "flex": 2,
            "component": {
              "id": "table",
              "type": "table",
              "title": "📈 Posts Table",
              "data": {
                "source": "api",
                "url": "https://jsonplaceholder.typicode.com/todos",
                "columns": [
                  {
                    "flex": 1,
                    "label": "ID",
                    "field": "userId"
                  },
                  {
                    "flex": 4,
                    "label": "Title",
                    "field": "title"
                  },
                  {
                    "flex": 2,
                    "label": "Is Done?",
                    "field": "completed"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "type": "container",
        "direction": "column",
        "flex": 2,
        "children": [
          {
            "type": "container",
            "direction": "row",
            "flex": 1,
            "children": [
              {
                "type": "component",
                "flex": 1,
                "component": {
                  "id": "weather",
                  "type": "text",
                  "title": "🌦️ Weather",
                  "data": {
                    "source": "api",
                    "url": "https://wttr.in/Yerevan?format=4"
                  }
                }
              },
              {
                "type": "component",
                "flex": 1,
                "component": {
                  "id": "advice",
                  "type": "text",
                  "title": "💡 Advice",
                  "data": {
                    "source": "api",
                    "json_path": "$.slip.advice",
                    "url": "https://api.adviceslip.com/advice",
                    "refresh_interval": 10
                  }
                }
              }
            ]
          },
          {
            "type": "component",
            "flex": 3,
            "component": {
              "id": "chart",
              "type": "chart",
              "title": "📙 Script Chart",
              "data": {
                "source": "script",
                "command": "./random_numbers.sh 10",
                "refresh_interval": 1,
                "refresh_mode": "append",
                "caption": "Random Script Values(append mode)"
              },
              "bindings": [
                {
                  "key": "g",
                  "label": "Snapshot 30 random values",
                  "action": {
                    "type": "replace_pane",
                    "command": "./random_numbers.sh 30",
                    "output_as": "inherit"
                  }
                }
              ]
            }
          },
          {
            "type": "component",
            "flex": 2,
            "component": {
              "id": "histogram",
              "type": "histogram",
              "title": "📊 Data Distribution",
              "data": {
                "source": "script",
                "command": "./histogram_data.sh",
                "refresh_interval": 5,
                "caption": "Distribution of fruites"
              }
            }
          }
        ]
      }
    ]
  }
}
