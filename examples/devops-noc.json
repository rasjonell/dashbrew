{
  "style": {
    "theme": "tokyo-night",
    "layout": { "gap": 1 },
    "focusMode": "highlight"
  },
  "layout": {
    "type": "container",
    "direction": "column",
    "children": [
      {
        "type": "component",
        "flex": 6,
        "component": {
          "id": "banner",
          "type": "text",
          "title": "ops",
          "icon": "▣",
          "titleAlign": "right",
          "data": {
            "source": "script",
            "command": "./examples/scripts/banner.sh noc",
            "refresh_interval": 60
          }
        }
      },
      {
        "type": "container",
        "direction": "row",
        "flex": 3,
        "children": [
          {
            "type": "component",
            "flex": 1,
            "component": {
              "id": "svc-api",
              "type": "text",
              "title": "api",
              "icon": "◯",
              "titleAlign": "center",
              "data": {
                "source": "script",
                "command": "./examples/scripts/service.sh api",
                "refresh_interval": 3
              },
              "style": {
                "palette": {
                  "border": "#3b5780",
                  "borderFocused": "#7aa2f7",
                  "accent": "#7aa2f7"
                }
              },
              "bindings": [
                {
                  "key": "d",
                  "label": "show api detail",
                  "action": {
                    "type": "replace_pane",
                    "command": "./examples/scripts/service-detail.sh api",
                    "output_as": "text"
                  }
                }
              ]
            }
          },
          {
            "type": "component",
            "flex": 1,
            "component": {
              "id": "svc-db",
              "type": "text",
              "title": "db",
              "icon": "▣",
              "titleAlign": "center",
              "data": {
                "source": "script",
                "command": "./examples/scripts/service.sh db",
                "refresh_interval": 3
              },
              "style": {
                "palette": {
                  "border": "#4b7045",
                  "borderFocused": "#9ece6a",
                  "accent": "#9ece6a"
                }
              },
              "bindings": [
                {
                  "key": "d",
                  "label": "show db detail",
                  "action": {
                    "type": "replace_pane",
                    "command": "./examples/scripts/service-detail.sh db",
                    "output_as": "text"
                  }
                }
              ]
            }
          },
          {
            "type": "component",
            "flex": 1,
            "component": {
              "id": "svc-cache",
              "type": "text",
              "title": "cache",
              "icon": "⬢",
              "titleAlign": "center",
              "data": {
                "source": "script",
                "command": "./examples/scripts/service.sh cache",
                "refresh_interval": 3
              },
              "style": {
                "palette": {
                  "border": "#7a5e2e",
                  "borderFocused": "#e0af68",
                  "accent": "#e0af68"
                }
              },
              "bindings": [
                {
                  "key": "d",
                  "label": "show cache detail",
                  "action": {
                    "type": "replace_pane",
                    "command": "./examples/scripts/service-detail.sh cache",
                    "output_as": "text"
                  }
                }
              ]
            }
          },
          {
            "type": "component",
            "flex": 1,
            "component": {
              "id": "svc-queue",
              "type": "text",
              "title": "queue",
              "icon": "⏵",
              "titleAlign": "center",
              "data": {
                "source": "script",
                "command": "./examples/scripts/service.sh queue",
                "refresh_interval": 3
              },
              "style": {
                "palette": {
                  "border": "#7a3a44",
                  "borderFocused": "#f7768e",
                  "accent": "#f7768e"
                }
              },
              "bindings": [
                {
                  "key": "d",
                  "label": "show queue detail",
                  "action": {
                    "type": "replace_pane",
                    "command": "./examples/scripts/service-detail.sh queue",
                    "output_as": "text"
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "type": "component",
        "flex": 4,
        "component": {
          "id": "latency",
          "type": "chart",
          "title": "p99 latency",
          "icon": "📈",
          "data": {
            "source": "script",
            "command": "./examples/scripts/latency.sh",
            "refresh_interval": 2,
            "refresh_mode": "append",
            "caption": "ms · all services aggregated · live append"
          },
          "bindings": [
            {
              "key": "s",
              "label": "snapshot 60 samples",
              "action": {
                "type": "replace_pane",
                "command": "./examples/scripts/latency.sh 60",
                "output_as": "inherit"
              }
            }
          ]
        }
      },
      {
        "type": "container",
        "direction": "row",
        "flex": 5,
        "children": [
          {
            "type": "component",
            "flex": 2,
            "component": {
              "id": "errors",
              "type": "histogram",
              "title": "responses by status",
              "icon": "▤",
              "titleAlign": "center",
              "data": {
                "source": "script",
                "command": "./examples/scripts/errors.sh",
                "refresh_interval": 4,
                "caption": "1-minute rollup"
              },
              "style": { "barStyle": "gradient" }
            }
          },
          {
            "type": "component",
            "flex": 3,
            "component": {
              "id": "logs",
              "type": "text",
              "title": "live log",
              "icon": "≡",
              "data": {
                "source": "script",
                "command": "./examples/scripts/log-tail.sh",
                "refresh_interval": 2
              },
              "bindings": [
                {
                  "key": "e",
                  "label": "errors only",
                  "action": {
                    "type": "replace_pane",
                    "command": "./examples/scripts/log-filtered.sh error",
                    "output_as": "text"
                  }
                },
                {
                  "key": "w",
                  "label": "warnings only",
                  "action": {
                    "type": "replace_pane",
                    "command": "./examples/scripts/log-filtered.sh warn",
                    "output_as": "text"
                  }
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
